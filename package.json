{
  "name": "naobi",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-led AI research and engineering portfolio operating system.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "=24.19.0",
    "pnpm": "=11.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "licenses:check": "node scripts/validate-licenses.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:workflows": "node scripts/validate-workflows.mjs",
    "verify": "pnpm verify:workflows && pnpm licenses:check && pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/node": "11.1.2",
    "@astrojs/react": "6.0.2",
    "astro": "7.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "7.0.5",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
